# Invest Tracker VPS / production example
# Copy this file to .env on your VPS and adjust values. Do NOT commit .env.

APP_TIMEZONE=Asia/Shanghai
DB_PATH=/app/data/invest.db

# --- 本机直接运行（python backend/main.py，不走 Docker）---
# 不设 DB_PATH 时，数据默认落平台标准目录；想把整套账放别的目录就用这个
# （DB_PATH 优先级仍然更高，设了它就不看 INVEST_TRACKER_HOME）
# INVEST_TRACKER_HOME=~/InvestTracker
# 监听地址与端口（默认 127.0.0.1:8000；要局域网访问改 HOST=0.0.0.0 并配 INVEST_TRACKER_PASSWORD）
# HOST=127.0.0.1
# PORT=8000
# 启动后不自动打开浏览器
# INVEST_TRACKER_NO_BROWSER=1
# 前端产物目录（默认自动找仓库里的 frontend/dist）
# FRONTEND_DIST=/path/to/dist

# System Password / PIN gate protection (Option 2)
# Set a password to enable the lock screen and API authentication.
# Leave empty or comment out to run in public/unlocked mode.
INVEST_TRACKER_PASSWORD=
# Cron 专用接口 token（定时任务调用，与登录密码独立）
# 生成：python3 -c 'import secrets; print(secrets.token_hex(24))'
# 配好后 cron_sync_prices.sh 走 HTTP /cron/*，不再 docker exec 内部函数
# CRON_API_TOKEN=

# --- 流水线心跳（可选，但强烈建议）---
# 解决的是「任务根本没跑」——备份脚本挂了、cron 被删、容器起不来，日志里全是安静。
# job 名固定三个：backup / sync_prices / snapshot
#
# 1) 对外 dead-man：配了 URL 就**只在成功时** ping（healthchecks.io 这类服务）。
#    失败或没跑就不 ping，由外部服务的超时规则自己报警——整机宕机也漏不掉。
# HEARTBEAT_BACKUP_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000
# HEARTBEAT_SYNC_PRICES_URL=
# HEARTBEAT_SNAPSHOT_URL=
#
# 2) 对内逾期检查：不需要配任何东西，`/cron/notify-events` 每次顺手判一次，
#    逾期（含「从来没成功过」）走消息推送的「运维」通道喊人。
#    默认阈值：backup 30 小时、sync_prices 96 小时、snapshot 96 小时（扛得住四天长假）。
# 需要改就覆盖（小时）：
# HEARTBEAT_BACKUP_MAX_AGE_HOURS=30
# HEARTBEAT_SYNC_PRICES_MAX_AGE_HOURS=96
# HEARTBEAT_SNAPSHOT_MAX_AGE_HOURS=96
# 登录 token 有效天数（改密会使旧 token 失效）
# TOKEN_TTL_DAYS=30
# 生产（ENV=production）下未设置 CORS 时默认关闭跨域，同源反代不受影响。
# 如需跨域请显式填域名（逗号分隔多个），不要用 *：
# CORS_ALLOW_ORIGINS=https://asset.anemy.org
# 前端在 Caddy/oauth2-proxy/反代之后时，设为 1 信任 X-Forwarded-For 以按客户端限流
# （仅当代理会覆盖该头时启用，否则会被人伪造 IP 绕过登录限流）
# TRUST_PROXY_HEADERS=1


# Bind frontend to localhost when using Caddy/Nginx reverse proxy.
# Change to 0.0.0.0 only if you intentionally expose it directly.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080

# Public domain for Caddy HTTPS and GitHub OAuth callback.
APP_DOMAIN=invest.example.com

# GitHub OAuth App credentials.
# GitHub OAuth callback URL must be: https://invest.example.com/oauth2/callback
GITHUB_OAUTH_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-github-oauth-client-secret

# Only this GitHub username can access the app.
GITHUB_OAUTH_ALLOWED_USER=your-github-username

# MUST decode to 16/24/32 bytes (AES). Prefer:
# python3 -c 'import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
# Do not wrap in quotes; no trailing spaces. Wrong length => oauth2-proxy Restarting.
OAUTH2_PROXY_COOKIE_SECRET=replace-with-32-byte-base64-secret

# --- 市场摘要 / 价格预警（可选）---
# 进程内行情缓存秒数（默认 120）；0 关闭缓存
# MARKET_QUOTE_CACHE_SECONDS=120
# 同规则预警冷却分钟（默认 240；也可用 settings.alert_cooldown_minutes）
# ALERT_COOLDOWN_MINUTES=240
# 强制写快照（忽略交易日历）
# CRON_FORCE_SNAPSHOT=0
# CRON_CHECK_ALERTS=1
# CRON_NOTIFY_ALERTS=0
# CRON_NOTIFY_EVENTS=1   # 盘后跑存款到期 + 纪律破线

# --- 多通道消息推送（invest-tracker 自有，独立于 Hermes）---
# 推荐：在网页「设置 → 消息推送」填写通道密钥（存库，优先于下方 .env）
# .env 仍可作服务器兜底或首次部署
# NOTIFY_ENABLED=1
# NOTIFY_TEMPLATE=medium          # short | medium
# NOTIFY_COOLDOWN_MINUTES=240     # 同事件同通道冷却
# 飞书：新名优先，旧 FEISHU_ALERT_WEBHOOK 仍兼容
# NOTIFY_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# FEISHU_ALERT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# 飞书二选一：自建应用（app_id + app_secret + 接收人 open_id），配了它就走消息 API，忽略 Webhook
# NOTIFY_FEISHU_APP_ID=cli_xxx
# NOTIFY_FEISHU_APP_SECRET=xxx
# NOTIFY_FEISHU_OPEN_ID=ou_xxx   # 开放平台「获取自己 open_id」/ 应用发消息拿
# 钉钉（可选加签）
# NOTIFY_DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxxx
# NOTIFY_DINGTALK_SECRET=
# 企业微信群机器人
# NOTIFY_WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx
# Telegram Bot
# NOTIFY_TELEGRAM_BOT_TOKEN=
# NOTIFY_TELEGRAM_CHAT_ID=
# 按事件选通道（逗号分隔：feishu,dingtalk,wecom,telegram）；设置页也可覆盖
# NOTIFY_ON_PRICE_ALERT=feishu,telegram
# NOTIFY_ON_EVENING_BRIEF=feishu
# NOTIFY_ON_DEPOSIT_DUE=telegram,feishu
# NOTIFY_ON_DISCIPLINE=feishu
# NOTIFY_ON_OPS=telegram
# NOTIFY_ON_TEST=feishu,dingtalk,wecom,telegram

# --- Cloudflare Tunnel（家用 VPS / 无公网 80/443 直连）---
# 隧道 Public Hostname 回源到 http://127.0.0.1:80（Caddy），禁止指 :8080
# CADDYFILE=./caddy/Caddyfile.tunnel
# FRONTEND_BIND=127.0.0.1


# --- AI 层（可选，默认关闭；网页「设置 → AI」写入 settings，优先于下方 .env）---
# AI_ENABLED=0
# AI_BASE_URL=https://api.deepseek.com
# AI_API_KEY=
# AI_MODEL=deepseek-chat
# AI_SHADOW_MODE=1
# AI_TIMEOUT_SECONDS=8
# AI_DAILY_CALL_CAP=30

